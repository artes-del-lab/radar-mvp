# Скопируйте этот файл в .env и впишите свои ключи:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — ключи останутся только у вас.

# --- Tenderplan ---
# Ключ из личного кабинета Тендерплана.
# Пока пусто — система работает на тестовых данных из data/mock_tenders.json.
TENDERPLAN_API_KEY=
# ID «ключа» (сохранённого поиска) в Тендерплане, по которому брать тендеры.
# Пусто — берутся тендеры по всем вашим ключам.
TENDERPLAN_SEARCH_KEY_ID=

# --- Anthropic (Claude) ---
# Ключ с https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=
# Модель для оценки тендеров и черновиков.
ANTHROPIC_MODEL=claude-sonnet-5
