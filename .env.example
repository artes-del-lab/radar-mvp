# Скопируйте этот файл в .env и впишите свои ключи:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — ключи останутся только у вас.

# --- Tenderplan ---
# Ключ из личного кабинета Тендерплана.
# Пока пусто — система работает на тестовых данных из data/mock_tenders.json.
TENDERPLAN_API_KEY=
# ID «ключа» (сохранённого поиска) в Тендерплане, по которому брать тендеры.
# Пусто — берутся тендеры по всем вашим ключам.
TENDERPLAN_SEARCH_KEY_ID=

# Источник тендеров: auto (Тендерплан, если есть ключ) или mock (тестовые данные).
DATA_SOURCE=auto

# --- Anthropic (Claude) ---
# Ключ с https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=
# Либо доступ через сторонний шлюз — тогда ANTHROPIC_API_KEY оставьте пустым:
# ANTHROPIC_BASE_URL=https://адрес-шлюза
# ANTHROPIC_AUTH_TOKEN=токен-шлюза
# Резервная модель при отказе: on / off. По умолчанию off, если задан шлюз.
# ANTHROPIC_FALLBACKS=off
# Модель для оценки тендеров и черновиков.
# claude-opus-5 — точнее; claude-sonnet-5 — примерно вдвое дешевле.
ANTHROPIC_MODEL=claude-opus-5
